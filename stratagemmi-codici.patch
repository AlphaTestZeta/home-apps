diff --git a/apps/stratagemmi/style.css b/apps/stratagemmi/style.css
index bbedba4..f48a6c5 100644
--- a/apps/stratagemmi/style.css
+++ b/apps/stratagemmi/style.css
@@ -54,3 +54,38 @@ html, body {
 @media (prefers-reduced-motion: reduce) {
   .arrow.show { animation-duration: .01s; }
 }
+
+/* Stratagemma attivato */
+.result {
+  position: fixed;
+  inset: 0;
+  display: grid;
+  place-content: center;
+  justify-items: center;
+  gap: 4vmin;
+  background: var(--nero);
+  z-index: 1;
+}
+.result[hidden] { display: none; }
+.result img { width: min(70vw, 70vh); height: min(70vw, 70vh); object-fit: contain; }
+.result img[hidden] { display: none; }
+.result p {
+  margin: 0;
+  max-width: 80vw;
+  text-align: center;
+  font: 700 clamp(28px, 8vmin, 72px)/1.1 system-ui, sans-serif;
+}
+
+/* Sequenza in basso */
+.seq {
+  position: fixed;
+  left: 0; right: 0;
+  bottom: calc(env(safe-area-inset-bottom, 0px) + 5vh);
+  display: flex;
+  justify-content: center;
+  gap: 2vmin;
+  z-index: 2;
+  pointer-events: none;
+}
+.seq svg { width: 9vmin; height: 9vmin; max-width: 56px; max-height: 56px; color: var(--giallo); }
+.seq.errore svg { color: #ff3b30; }
diff --git a/apps/stratagemmi/tools/check-codes.js b/apps/stratagemmi/tools/check-codes.js
new file mode 100644
index 0000000..0c8833b
--- /dev/null
+++ b/apps/stratagemmi/tools/check-codes.js
@@ -0,0 +1,17 @@
+// Uso (dalla cartella apps/stratagemmi):  node tools/check-codes.js
+const fs = require("fs");
+const S = new Function(fs.readFileSync(__dirname + "/../stratagems.js", "utf8") + "; return STRATAGEMS;")();
+let problemi = 0;
+const ids = new Set(), codes = new Map();
+for (const s of S) {
+  if (!/^[UDLR]+$/.test(s.code)) { console.log("Codice non valido:", s.name, s.code); problemi++; }
+  if (ids.has(s.id)) { console.log("ID doppio:", s.id); problemi++; }
+  ids.add(s.id);
+  if (codes.has(s.code)) { console.log("Codice doppio:", s.name, "=", codes.get(s.code)); problemi++; }
+  codes.set(s.code, s.name);
+}
+for (const a of S) for (const b of S)
+  if (a !== b && b.code.length > a.code.length && b.code.startsWith(a.code)) {
+    console.log("Prefisso:", a.name, `(${a.code})`, "è l'inizio di", b.name, `(${b.code})`); problemi++;
+  }
+console.log(`${S.length} stratagemmi, ${problemi} problemi`);
